{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.html", "public/**", "package.json", "tsconfig*.json", "vite.config.ts"],
      "outputs": ["dist/**", "lib/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "*.config.{ts,mjs}", "package.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig*.json", "eslint.config.mjs", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig*.json", "vite.config.ts", "vitest.config.ts", "package.json"]
    },
    "guards": {
      "inputs": ["src/**", "scripts/**", "package.json"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "gate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
