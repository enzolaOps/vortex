{
  "name": "app",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "A interface v1 do Vortex: shell, jornadas e design system. Consome o nucleo como fonte TS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:gate": "vite build --mode gate --outDir dist-gate",
    "gate:servir": "vite preview --mode gate --outDir dist-gate --port 4174 --strictPort",
    "gate": "node scripts/gate.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:fumaca": "playwright test --config e2e/playwright.config.ts --grep @fumaca",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tokens": "node scripts/tokens.mjs",
    "tokens:conferir": "node scripts/tokens.mjs --conferir",
    "vidro": "node scripts/vidro.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "guards": "pnpm tokens:conferir && pnpm vidro",
    "check": "pnpm typecheck && pnpm lint && pnpm guards && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "^0.540.0",
    "nucleo": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "oxc-transform-react": "^0.148.0",
    "playwright": "^1.55.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
